# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# Local MongoDB (docker compose) or a MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/fuel_ride

# Two different random secrets, at least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Comma-separated origins allowed to call the API with cookies (Vite dev server)
CORS_ORIGIN=http://localhost:5173

# bcrypt cost factor (12 recommended in production)
BCRYPT_COST=12

# Optional
# REFRESH_TOKEN_TTL_DAYS=7
# COOKIE_SECURE=true          # defaults to true when NODE_ENV=production
# WEB_DIST_PATH=/app/apps/web/dist
